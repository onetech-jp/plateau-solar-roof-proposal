# コピーして .env にリネームし、値を入れる(.env は git 管理外)
# サーバー用: Solar API / Geocoding API / Maps Static API を許可。ブラウザには渡さない
GOOGLE_MAPS_SERVER_KEY=
# ブラウザ用: Maps JavaScript API のみ許可。HTTPリファラ制限(localhost:5194/*)を必ず設定
GOOGLE_MAPS_BROWSER_KEY=
# 1本のキーで済ませる場合はこちら(上2つが空ならこれを両方に使う)
GOOGLE_MAPS_API_KEY=
# Solar API を呼ばず疑似データで UI を確認したいとき 1
MOCK_SOLAR=
PORT=5194
# サーバー側の1日上限(Google の割り当てとは別に、サーバーが数えて止める)
SOLAR_DAILY_LIMIT=100
GEOCODE_DAILY_LIMIT=100
STATICMAP_DAILY_LIMIT=200
